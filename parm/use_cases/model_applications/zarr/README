========================================================
ZARR WORKFLOW (INSPECT + SAVE NPZ + PLOT)
========================================================

--------------------------------------------------------
1) INSTALL DEPENDENCIES
--------------------------------------------------------

# Create conda environment
conda create -p env python=3.11 -y

# Activate your environment
conda activate env

# Install requirements (pip style)
pip install -r requirements.txt

--------------------------------------------------------
2) INSPECT ZARR FILE
--------------------------------------------------------

# Print summary of Zarr dataset using config file
python inspect_zarr.py zarr.conf

# Save extracted field + lat/lon to NPZ
python inspect_zarr.py config.conf --write out.npz

--------------------------------------------------------
3) VERIFY NPZ CONTENTS
--------------------------------------------------------

python - << 'EOF'
import numpy as np
f = np.load("out.npz", allow_pickle=True)
print("Keys in file:", f.files)
EOF

--------------------------------------------------------
4) PLOT NPZ FIELD (DISCRETE COLORBAR)
--------------------------------------------------------

# Automatic color scale (robust percentiles)
python plot.py out.npz out.png --nbins 10

# Custom color scale
python plot.py out.npz out.png \
    --vmin 265 \
    --vmax 300 \
    --nbins 10 \
    --cbar_label "Temperature (K)"

--------------------------------------------------------
5) LIST VARIABLES INSIDE ZARR STORE
--------------------------------------------------------

python - << 'EOF'
import zarr
root = zarr.open("path_to_zarr.zarr", mode="r")
print("Arrays:", list(root.array_keys()))
print("Groups:", list(root.group_keys()))
EOF

--------------------------------------------------------
6) LOAD COORDINATE ARRAY FROM CONFIG
--------------------------------------------------------

python - << 'EOF'
from zarr_reader import get_coord_array_from_conf
arr = get_coord_array_from_conf("zarr.conf", "FCST_ZARR_LEAD_VAR")
print(arr)
EOF

========================================================
END
========================================================

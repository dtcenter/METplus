#%Module######################################################################
##
##      METplus
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METplus-13.0.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

#module unload cray-libsci/24.07.0
module load intel/2025.2
module use -a /usw/met/modulefiles
module load met/13.0.0
module load nco
module load wgrib
module load wgrib2

setenv METPLUS_PATH /usw/met/METplus/METplus-13.0.0
prepend-path PATH /usw/met/METplus/METplus-13.0.0/ush:/lustre/f2/dev/esrl/Julie.Prestopnik/projects/miniconda/miniconda3/envs/metplus_v13.0_py3.14/bin



#%Module######################################################################
##
##      METplus
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METplus-6.1.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

module unload cray-libsci/24.07.0
module load intel/2023.2.0
module use -a /usw/met/modulefiles
module load met/12.1.0
module load nco
module load wgrib
module load wgrib2

setenv METPLUS_PATH /usw/met/METplus/METplus-6.1.0
prepend-path PATH /usw/met/METplus/METplus-6.1.0/ush:/lustre/f2/dev/esrl/Julie.Prestopnik/projects/miniconda/miniconda3/envs/metplus_v5.1_py3.10/bin



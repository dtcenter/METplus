#%Module######################################################################
##
##      METplus
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METplus-6.1.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

prereq intel-oneapi-compilers/2025.1.1
prepend-path PATH /scratch3/BMC/dtc/METplus/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin

module use -a /contrib/met/modulefiles
module load met/12.1.0-rc1
module load nco
module load wgrib2
setenv METPLUS_PATH /contrib/METplus/METplus-6.1.0-rc1
prepend-path PATH /contrib/METplus/METplus-6.1.0-rc1/ush

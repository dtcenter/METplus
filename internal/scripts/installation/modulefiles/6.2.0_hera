#%Module######################################################################
##
##      METplus
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METplus-6.2.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

prereq intel/2024.2.1
prepend-path PATH /scratch1/BMC/dtc/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin

module use -a /contrib/met/modulefiles
module load met/12.2.0
module load nco
module load wgrib
module load wgrib2
module load R
setenv METPLUS_PATH /contrib/METplus/METplus-6.2.0
prepend-path PATH /contrib/METplus/METplus-6.2.0/ush
